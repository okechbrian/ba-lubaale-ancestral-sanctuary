# Copy to .env.local for local development. Never commit real values.
# Status column = what the code does TODAY when the key is empty.

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Dummy placeholder until the owner supplies the real number (button hides when empty)
NEXT_PUBLIC_WHATSAPP_NUMBER=256700000000
# Booking + payment notifications land here. Also receives the ops alerts:
# an email parked as terminally failed, and payments the reconciliation sweep
# could not settle.
OWNER_NOTIFY_EMAIL=queennalubaale@gmail.com

# ── Error monitoring (OPTIONAL) ───────────────────────────────────────────────
# Missing => failures are logged to the server console only (Vercel logs), and
# nothing is sent anywhere. Set it to a Sentry (or compatible) DSN and failed
# requests are forwarded with PII scrubbed: guest names, emails, WhatsApp
# numbers and any phone-shaped string are redacted before they leave the app,
# and only ids survive.
SENTRY_DSN=

# ── Database — Supabase (REQUIRED for booking intake and /admin) ────────────
# Missing => POST /api/bookings returns 503 database_not_configured and the
# apply form shows an honest "temporarily unavailable" message (no fake success).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Payments — Pesapal (REQUIRED for approve => payment link) ───────────────
# Missing => clearly named UnavailablePaymentProvider: the Approve button is
# disabled with a banner; no invented payment links are ever generated.
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
# Must match the IPN URL registered in the Pesapal dashboard
PESAPAL_IPN_URL=

# ── Email — Gmail SMTP app password (REQUIRED to actually send) ─────────────
# Missing => UnavailableEmailSender: every email is stored in the email_log
# table with status=stubbed and shown in /admin/emails as NOT SENT.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Admin console login (/admin) ────────────────────────────────────────────
# ADMIN_PASSWORD: pick a long one (min 12 chars). ADMIN_SESSION_SECRET: random
# 32+ chars (e.g. `openssl rand -hex 32`). Both required before /admin is usable.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ── Email outbox processor ───────────────────────────────────────────────────
# Payment emails are queued inside the payment transaction. They are normally
# delivered INLINE by the IPN itself (a few rows, best effort, right after a
# settled payment) so the guest hears immediately. This cron is the SAFETY NET
# for anything the inline pass did not deliver.
#
# GET/POST https://<your-domain>/api/cron/email-outbox. Vercel sends
# `Authorization: Bearer <CRON_SECRET>` automatically; the route REFUSES to run
# when this is unset (503 cron_secret_missing), so nobody can trigger mail
# delivery from the internet. Generate with `openssl rand -hex 32`.
CRON_SECRET=

# ── Email outbox cron SCHEDULE (deploy-time, not runtime) ─────────────────────
# Vercel parses vercel.json as static JSON and cannot interpolate an environment
# variable into `crons[].schedule`, so this is consumed by a script at deploy
# time rather than by the running app:
#
#   node scripts/set-cron-schedule.mjs          # apply this value
#   node scripts/set-cron-schedule.mjs --check  # fail if vercel.json disagrees
#
# Leave UNSET (or set `0 8 * * *`) on Hobby: one tick a day, 08:00 UTC.
# Set the five-minute expression ONLY on a Pro plan ($20/mo):
#
#   EMAIL_OUTBOX_CRON=*/5 * * * *
#
# Do NOT set a sub-daily value on Hobby. Vercel rejects it by failing the ENTIRE
# deployment, and for git pushes that failure is silent — no deployment object is
# created, so nothing shows in the dashboard and the branch just stops getting
# previews. The script warns loudly when you pick one.
#
# Losing a cron tick is not a correctness problem: queued rows stay queued and
# the next tick (or the owner's Resend button in /admin/emails) delivers them.
EMAIL_OUTBOX_CRON=

# ── Abuse protection — rate limiting (Upstash Redis REST) ────────────────────
# Provider: Upstash Redis over plain REST — no SDK dependency, host-agnostic
# (Vercel KV is the same Upstash backend but locks the site to Vercel).
# Limits: /api/admin/login 5 / 15 min per IP · POST /api/bookings 3 / hour.
# Missing keys => the limiter is DISABLED LOUDLY: requests pass, one
# console.warn per process, and every response carries
# `x-ratelimit-mode: disabled-missing-config` — never a silent bypass.
# Documented fail-open/closed choice when the backend ERRORS at runtime:
#   POST /api/bookings  -> FAIL-OPEN  (guest intake stays up; header shows
#                          x-ratelimit-mode: fail-open)
#   /api/admin/login    -> FAIL-CLOSED (503 rate_limiter_unavailable —
#                          brute-force protection beats login availability)
# Missing keys (as opposed to a backend error) are a separate switch:
#   outside production  -> DISABLED LOUDLY (requests pass, header shows
#                          x-ratelimit-mode: disabled-missing-config)
#   /api/admin/login in production -> 503 rate_limiter_unavailable
#                          (x-ratelimit-mode: fail-closed-missing-config). An
#                          unconfigured brute-force guard must never silently
#                          accept unlimited attempts on a live site.
# Escape hatch: ALLOW_UNTHROTTLED_ADMIN=1 accepts unthrottled admin logins.
ALLOW_UNTHROTTLED_ADMIN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Abuse protection — which client IP may we trust? ─────────────────────────
# The limiter buckets per client IP, so a spoofable header = a bypassable
# limit. Resolution order (lib/client-ip.ts):
#   1. cf-connecting-ip / cf-real-ip  — ONLY when TRUST_CLOUDFLARE_IP=1
#   2. x-vercel-forwarded-for         — written by the Vercel edge
#   3. x-forwarded-for, RIGHTMOST hop — appended by the platform, not choosable
#   4. x-real-ip                      — only off Vercel (own reverse proxy)
# Leave TRUST_CLOUDFLARE_IP UNSET unless the domain really is proxied by
# Cloudflare. A client can send cf-connecting-ip itself on plain Vercel, and
# trusting it hands every attacker a fresh rate-limit bucket per request.
# Behind Cloudflare, Vercel only sees Cloudflare's edge IP — set the flag to
# get the real client instead of lumping everyone into one bucket.
TRUST_CLOUDFLARE_IP=

# ── Abuse protection — Cloudflare Turnstile on /apply ───────────────────────
# BOTH keys are required to enforce: a secret without a sitekey would brick
# the form (no human could ever obtain a token). Missing either => verification
# is DISABLED LOUDLY: requests pass, one console.warn per process, responses
# carry `x-turnstile-mode: disabled-missing-keys`.
# When enabled the check is FAIL-CLOSED and never silent:
#   no token           -> 403 turnstile_required
#   siteverify rejects -> 403 turnstile_failed
#   Cloudflare down    -> 503 turnstile_unavailable (unverified tokens never pass)
# Create widgets at dash.cloudflare.com -> Turnstile.
# Official test keys (safe to commit): site 1x00000000000000000000AA always
# passes, 2x00000000000000000000AB always fails; secrets
# 1x0000000000000000000000000000000AA (pass) / 2x0000000000000000000000000000000AA (fail).
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
